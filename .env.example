# PUBLIC CLIENT CONFIGURATION — never put secrets in VITE_ variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
VITE_DEMO_MODE=false
# Vercel Preview only: set true in the Preview environment scope. It is ignored
# unless Vercel also sets VERCEL_ENV=preview; leave unset/false elsewhere.
VITE_PREVIEW_DEMO=false
VITE_INSTAGRAM_USERNAME=
VITE_WHATSAPP_NUMBER=
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_INTERNATIONAL_MODE=disabled
VITE_TURNSTILE_SITE_KEY=

# SERVER ONLY — configure as Supabase Edge secrets, never Vite variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_CLEANUP_SECRET=
SITE_URL=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
TRACKING_HASH_SECRET=
BANK_TRANSFER_ACCOUNT_CONFIRMED=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
NOTIFICATION_WORKER_SECRET=
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Card, Bit, PayBox and PayPal remain unavailable until a merchant adapter is
# implemented and verified. Merely setting credentials cannot activate them.
NOTIFICATION_RECEIPTS_ENABLED=false
RESEND_WEBHOOK_SECRET=
